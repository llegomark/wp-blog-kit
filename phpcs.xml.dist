<?xml version="1.0"?>
<ruleset name="WP blog kit">
	<description>WordPress Coding Standards (WordPress-Core, WordPress-Docs, WordPress-Extra) for the Tala Blog theme and the Tala SEO and Tala Ads plugins.</description>

	<file>tala-seo</file>
	<file>tala-ads</file>
	<file>tala-blog</file>
	<file>tests</file>

	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/dev/*</exclude-pattern>
	<exclude-pattern>*/.agents/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress"/>

	<!-- WordPress itself looks for "index.asset.php" next to a block's "index.js", so that exact
	     name can't follow the lowercase-with-hyphens rule. Only that rule is skipped, only there. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*.asset.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="tala-seo"/>
				<element value="tala-ads"/>
				<element value="tala-blog"/>
			</property>
		</properties>
	</rule>

	<!-- tala_blog_block_text() escapes text for block markup (JSON, via core's
	     serialize_block_attributes()); the patterns echo its output into block comments. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="tala_blog_block_text"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="tala_seo"/>
				<element value="tala_ads"/>
				<element value="tala_blog"/>
			</property>
			<property name="custom_test_classes" type="array">
				<element value="Tala_SEO_Test_Case"/>
			</property>
		</properties>
		<!-- The tests' bootstrap and config run before WordPress and define its own constants
		     (ABSPATH, DB_NAME), and the WP-CLI stand-in has WP-CLI's names: none can take a prefix. -->
		<exclude-pattern>tests/phpunit/bootstrap\.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/wp-tests-config\.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/includes/env\.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/includes/class-wp-cli\.php</exclude-pattern>
		<exclude-pattern>tests/phpunit/includes/wp-cli-utils\.php</exclude-pattern>
	</rule>

	<!-- Tests extend this base class (tests/phpunit/includes/class-tala-seo-test-case.php). -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="custom_test_classes" type="array">
				<element value="Tala_SEO_Test_Case"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<properties>
			<property name="custom_test_classes" type="array">
				<element value="Tala_SEO_Test_Case"/>
			</property>
		</properties>
	</rule>
</ruleset>
