{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#fcfcfc" },
				{ "slug": "contrast", "name": "Text", "color": "#3f3f3f" },
				{ "slug": "muted", "name": "Secondary text", "color": "#5d5d5d" },
				{ "slug": "accent", "name": "Emphasis (links on hover, buttons, focus)", "color": "#000000" },
				{ "slug": "rule", "name": "Lines", "color": "#d4d4d4" },
				{ "slug": "wash", "name": "Wash (quotes, code)", "color": "#f5f5f5" }
			]
		},
		"custom": {
			"dark": {
				"base": "#121212",
				"contrast": "#e3e3e3",
				"muted": "#a3a3a3",
				"accent": "#ffffff",
				"rule": "#3d3d3d",
				"wash": "#1c1c1c"
			}
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "60rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "0.75rem" },
				{ "slug": "30", "name": "M", "size": "1.25rem" },
				{ "slug": "40", "name": "L", "size": "2rem" },
				{ "slug": "50", "name": "XL", "size": "3rem" },
				{ "slug": "60", "name": "XXL", "size": "4.5rem" }
			],
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System sans-serif (no download)",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
				},
				{
					"slug": "system-serif",
					"name": "System serif (no download)",
					"fontFamily": "\"Iowan Old Style\", Charter, \"Bitstream Charter\", \"Noto Serif\", Georgia, serif"
				},
				{
					"slug": "system-mono",
					"name": "System monospace (no download)",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "large", "name": "Large", "size": "1.4375rem", "fluid": { "min": "1.25rem", "max": "1.4375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.1875rem", "fluid": { "min": "1.625rem", "max": "2.1875rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|accent" }, "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": { "fontWeight": "600", "lineHeight": "calc(1em + 0.5rem)" }
			},
			"h1": {
				"typography": { "fontSize": "var:preset|font-size|xx-large", "letterSpacing": "-0.02rem" }
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|x-large", "letterSpacing": "-0.02rem" }
			},
			"h3": {
				"typography": { "fontSize": "var:preset|font-size|large", "letterSpacing": "-0.01rem" }
			},
			"h4": {
				"typography": { "fontSize": "var:preset|font-size|medium" }
			},
			"button": {
				"border": { "radius": "5px" },
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" },
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "600" },
				":hover": { "color": { "background": "var:preset|color|accent", "text": "var:preset|color|base" } }
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "600", "lineHeight": "1.3" },
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/quote": {
				"border": { "radius": "5px" },
				"color": { "background": "var:preset|color|wash" },
				"spacing": { "padding": { "top": "var:preset|spacing|30", "right": "var:preset|spacing|30", "bottom": "var:preset|spacing|30", "left": "var:preset|spacing|30" } }
			},
			"core/code": {
				"border": { "color": "var:preset|color|rule", "radius": "5px", "style": "solid", "width": "1px" },
				"spacing": { "padding": { "top": "var:preset|spacing|20", "right": "var:preset|spacing|30", "bottom": "var:preset|spacing|20", "left": "var:preset|spacing|30" } },
				"typography": { "fontFamily": "var:preset|font-family|system-mono", "fontSize": "0.9em" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|rule" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
