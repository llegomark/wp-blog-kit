<?xml version="1.0"?>
<!--
	PHPUnit integration tests on WordPress's own test framework (wp-phpunit): each test runs inside a
	database transaction against a real WordPress, with Tala SEO, Tala Ads and Tala Guard active and Tala Blog as the theme.
	Run them with `composer test` (see tests/bin/install-wp-tests.sh for what it sets up first).
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/phpunit/bootstrap.php"
	cacheResultFile=".cache/phpunit.result.cache"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutOutputDuringTests="true"
	convertDeprecationsToExceptions="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="tala-seo">
			<directory prefix="test-" suffix=".php">tests/phpunit/tala-seo</directory>
		</testsuite>
		<testsuite name="tala-ads">
			<directory prefix="test-" suffix=".php">tests/phpunit/tala-ads</directory>
		</testsuite>
		<testsuite name="tala-guard">
			<directory prefix="test-" suffix=".php">tests/phpunit/tala-guard</directory>
		</testsuite>
		<testsuite name="tala-blog">
			<directory prefix="test-" suffix=".php">tests/phpunit/tala-blog</directory>
		</testsuite>
	</testsuites>
</phpunit>
